{
  "name": "engineering-style-guide",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run storybook",
    "storybook": "npm run storybook -w @milaha/ui",
    "build-storybook": "npm run build-storybook -w @milaha/ui",
    "build": "npm run build -w @milaha/ui",
    "typecheck": "npm run typecheck -w @milaha/ui",
    "test": "npm run test -w @milaha/ui",
    "test:run": "npm run test:run -w @milaha/ui",
    "test:storybook": "npm run test:storybook -w @milaha/ui",
    "test:storybook:run": "npm run test:storybook:run -w @milaha/ui",
    "ci": "npm run typecheck && npm run build && npm run test:run && npm run build-storybook && npm run test:storybook:run"
  }
}
