{
  "name": "engineering-style-guide",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run storybook",
    "storybook": "pnpm --filter @qatar-navigation-milaha/ui run storybook",
    "build-storybook": "pnpm --filter @qatar-navigation-milaha/ui run build-storybook",
    "build": "pnpm --filter @qatar-navigation-milaha/ui run build",
    "typecheck": "pnpm --filter @qatar-navigation-milaha/ui run typecheck",
    "test": "pnpm --filter @qatar-navigation-milaha/ui run test",
    "test:run": "pnpm --filter @qatar-navigation-milaha/ui run test:run",
    "test:storybook": "pnpm --filter @qatar-navigation-milaha/ui run test:storybook",
    "test:storybook:run": "pnpm --filter @qatar-navigation-milaha/ui run test:storybook:run",
    "ci": "pnpm run typecheck && pnpm run build && pnpm run test:run && pnpm run build-storybook && pnpm run test:storybook:run"
  }
}
