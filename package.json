{
  "name": "engineering-style-guide",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run storybook",
    "storybook": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run storybook",
    "build-storybook": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run build-storybook",
    "build": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run build",
    "typecheck": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run typecheck",
    "test": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run test",
    "test:run": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run test:run",
    "test:storybook": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run test:storybook",
    "test:storybook:run": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run test:storybook:run",
    "test:storybook:coverage": "bash scripts/with-project-node.sh pnpm --filter @qatar-navigation-milaha/ui run test:storybook:coverage",
    "ci": "bash scripts/with-project-node.sh pnpm run typecheck && pnpm run build && pnpm run test:run && pnpm run build-storybook && pnpm run test:storybook:run"
  }
}
