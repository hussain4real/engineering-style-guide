{
  "name": "@qatar-navigation-milaha/create-project",
  "version": "0.1.2",
  "description": "Interactive Milaha project starter CLI.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussain4real/engineering-style-guide.git",
    "directory": "packages/create-project"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "bin": {
    "milaha": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest --config vitest.config.ts --run",
    "sync:harness": "node scripts/sync-harness.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
